# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional OSRM-compatible routing service. Defaults to the public OSRM demo service.
# Route duration is a route estimate, never live traffic.
MOBILITY_ROUTING_BASE_URL=https://router.project-osrm.org

# Supabase Configuration (required for auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Map Configuration
# Optional full MapLibre style. Empty uses attributed OpenStreetMap street tiles.
NEXT_PUBLIC_MAP_STYLE_URL=
# Optional raster provider; use its required attribution via a full style for other providers.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# App Configuration
NEXT_PUBLIC_APP_NAME=Human Mobility Intelligence
NEXT_PUBLIC_APP_VERSION=0.1.0
