# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Frontend Configuration
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase (required for protected operations; use the same project as the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# No service-role key or database password is needed by the running app.

# Data Mode
DATA_MODE=historical
SYNTHETIC_DATA_ENABLED=false

# Optional GTFS-Realtime feeds; leave empty until a valid provider URL is known.
# Add api_key_env/headers_env only when the provider's authentication is documented.
GTFS_RT_FEEDS=[]

# API Configuration
API_TITLE=Human Mobility Intelligence API
API_VERSION=0.1.0
